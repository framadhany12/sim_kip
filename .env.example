# Salin menjadi .env.local (atau .env) lalu sesuaikan. JANGAN commit file berisi kata sandi asli.

# Koneksi MySQL/MariaDB. Format: mysql://user:password@host:port/nama_database
# Database dibuat otomatis (utf8mb4) bila belum ada; tabel dibuat lewat migrasi saat aplikasi pertama jalan.
DATABASE_URL=mysql://root@127.0.0.1:3306/sim_kip

# Akun admin pertama (hanya dibuat saat tabel users masih kosong). WAJIB diganti di produksi.
ADMIN_EMAIL=admin@kip.local
ADMIN_PASSWORD=ganti-dengan-sandi-kuat

# Pengiriman email (verifikasi pendaftar & lupa kata sandi) lewat SMTP.
# Tanpa SMTP_HOST, email tidak dikirim: tautan hanya dicetak ke log server (dan tampil di layar saat npm run dev).
# Contoh Gmail/Google Workspace: buat "App Password" (wajib verifikasi 2 langkah aktif), lalu:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=pmb.kip@poltektedc.ac.id
# SMTP_PASS=xxxxxxxxxxxxxxxx
# SMTP_FROM="KIP Kuliah Politeknik TEDC <pmb.kip@poltektedc.ac.id>"

# Alamat publik aplikasi, dipakai untuk tautan di dalam email (wajib diisi di produksi).
# APP_URL=https://kip.poltektedc.ac.id


# Kunci enkripsi rahasia authenticator admin (login 2 langkah). WAJIB di produksi; buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Jangan diubah setelah admin mengaktifkan authenticator, kalau tidak mereka harus diatur ulang.
MFA_KEY=
